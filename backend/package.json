{
  "name": "nexa-play-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da plataforma Nexa Play / Nexa Quest",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:render": "npm run db:migrate && npm run db:seed && npm start",
    "dev": "node --watch src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "admin:create": "node scripts/create-admin.js",
    "db:status": "sequelize-cli db:migrate:status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "sequelize-cli": "6.6.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}

