NODE_ENV=development
PORT=3000

# Banco local MySQL; no Render, use DB_DIALECT=postgres e DATABASE_URL.
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexa_play
DB_USER=root
DB_PASSWORD=
DB_SSL=false
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Gere uma chave aleatória com pelo menos 32 caracteres antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_NAME=nexa_session
COOKIE_SECURE=false

# Origens locais autorizadas a chamar a API com credenciais.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_APP_URL=http://localhost:5500
# API_PUBLIC_URL é descoberta do Render em produção; ajuste se a API ficar em outro domínio.

